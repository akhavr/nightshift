#!/bin/bash
# Pre-commit hook to reject conflict markers
# Installed by: nightshift init

# Check staged files for conflict markers
if git diff --cached --name-only -z | xargs -0 -r grep -lE '^(<<<<<<<|=======|>>>>>>>)' 2>/dev/null; then
    echo "ERROR: Conflict markers found in staged files." >&2
    echo "Resolve all conflicts before committing." >&2
    exit 1
fi

exit 0
