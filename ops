{"author":{"id":"2462ded6f56967dde059994c39a506c79e39e5dfd10c5a07f07a23a5652a8353"},"ops":[{"type":1,"timestamp":1773591700,"nonce":"RxYJYRKNrqF2Nt5RdGWj6CIzpOs=","title":"Worktree .git file left with container path after container exits","message":"docker-entrypoint.sh rewrites the worktree .git file to use /repo-git/worktrees/... (container path). Since the worktree is mounted rw, this persists on the host after the container exits. Any host-side git operation in that worktree then fails because /repo-git doesn't exist on the host.\n\nFix: save the original .git content before docker run and restore it after container exits.\n\nREQ-001","files":null}]}